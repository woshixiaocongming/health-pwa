    "type": "git",
    "url": "git+https://github.com/woshixiaocongming/health-pwa.git"
  },
  "keywords": [
    "pwa",
    "health",
    "capacitor",
    "android"
  ],
  "author": "woshixiaocongming",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/woshixiaocongming/health-pwa/issues"
  },
  "homepage": "https://github.com/woshixiaocongming/health-pwa#readme",
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3"
  }
}
